# HEIMDALL configuration template. Copy to .env and fill in locally.
# .env is git-ignored. Never commit real credentials.
# Variable names for the data source are provisional until the authorized
# access method has been inspected.

# Id of the registered data-source adapter: irsa-spherex (public IRSA archive)
# or local-fits (FITS files in HEIMDALL_LOCAL_FITS_DIR).
HEIMDALL_DATA_SOURCE=

# Credential for the data source. Leave empty here; set it only in .env.
# The public IRSA SPHEREx archive needs none.
HEIMDALL_SOURCE_CREDENTIAL=

# Directory of SPHEREx L2 FITS files for the local-fits adapter.
HEIMDALL_LOCAL_FITS_DIR=

# Investigation runs and validation records (git-ignored by default).
HEIMDALL_STATE_DIR=.heimdall/state

# 1 = never contact network services; use cached archive responses and products only.
HEIMDALL_OFFLINE=0

# Local cache directory (git-ignored by default).
HEIMDALL_CACHE_DIR=.heimdall/cache

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
HEIMDALL_LOG_LEVEL=INFO

# Network behaviour (operational defaults, no scientific meaning).
HEIMDALL_REQUEST_TIMEOUT_S=60
HEIMDALL_MAX_RETRIES=3
