# Example systemd unit for the HEIMDALL data worker. NOT installed by HEIMDALL; adapt paths/user, then:
#   sudo cp deploy/heimdall-worker.service /etc/systemd/system/ && sudo systemctl enable --now heimdall-worker
# Health: `python3 -m heimdall data status` -> metrics.worker (heartbeat age). Credentials only via the environment file.
[Unit]
Description=HEIMDALL SPHEREx data worker (durable acquisition, retries, recovery)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/heimdall
EnvironmentFile=-/opt/heimdall/.env
ExecStart=/usr/bin/python3 -m heimdall data worker --max-idle 30
# SIGTERM lets the current bounded step finish; leases recover anything killed harder.
KillSignal=SIGTERM
TimeoutStopSec=600
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
